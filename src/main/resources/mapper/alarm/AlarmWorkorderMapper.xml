<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hpis.alarm.mapper.AlarmWorkorderMapper">

    <!-- uk_alarm_workorder_alarm(alarm_id) 由数据库兜底保证一警一单。 -->
    <resultMap type="AlarmWorkorder" id="AlarmWorkorderResult">
        <result property="workorderId" column="workorder_id"/>
        <result property="workorderNo" column="workorder_no"/>
        <result property="alarmId" column="alarm_id"/>
        <result property="workorderConfigId" column="workorder_config_id"/>
        <result property="status" column="status"/>
        <result property="assigneeId" column="assignee_id"/>
        <result property="assigneeName" column="assignee_name"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="handleResult" column="handle_result"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectAlarmWorkorderVo">
        select workorder_id, workorder_no, alarm_id, workorder_config_id, status, assignee_id,
               assignee_name, title, content, handle_result, tenant_id, del_flag, create_by,
               create_time, update_by, update_time
        from alarm_workorder
    </sql>

    <select id="selectAlarmWorkorderById" parameterType="Long" resultMap="AlarmWorkorderResult">
        <include refid="selectAlarmWorkorderVo"/>
        where workorder_id = #{workorderId}
          and del_flag = '0'
    </select>

    <select id="selectAlarmWorkorderByAlarmId" parameterType="Long" resultMap="AlarmWorkorderResult">
        <include refid="selectAlarmWorkorderVo"/>
        where alarm_id = #{alarmId}
          and del_flag = '0'
        limit 1
    </select>

    <select id="selectAlarmWorkorderList" parameterType="AlarmWorkorder" resultMap="AlarmWorkorderResult">
        <include refid="selectAlarmWorkorderVo"/>
        <where>
            del_flag = '0'
            <if test="alarmId != null">and alarm_id = #{alarmId}</if>
            <if test="workorderNo != null and workorderNo != ''">and workorder_no = #{workorderNo}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="assigneeId != null">and assignee_id = #{assigneeId}</if>
            <if test="tenantId != null">and tenant_id = #{tenantId}</if>
        </where>
        order by create_time desc, workorder_id desc
    </select>

    <insert id="insertAlarmWorkorder" parameterType="AlarmWorkorder" useGeneratedKeys="true" keyProperty="workorderId">
        insert into alarm_workorder
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="workorderNo != null and workorderNo != ''">workorder_no,</if>
            <if test="alarmId != null">alarm_id,</if>
            <if test="workorderConfigId != null">workorder_config_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="assigneeId != null">assignee_id,</if>
            <if test="assigneeName != null and assigneeName != ''">assignee_name,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="handleResult != null and handleResult != ''">handle_result,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="workorderNo != null and workorderNo != ''">#{workorderNo},</if>
            <if test="alarmId != null">#{alarmId},</if>
            <if test="workorderConfigId != null">#{workorderConfigId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="assigneeId != null">#{assigneeId},</if>
            <if test="assigneeName != null and assigneeName != ''">#{assigneeName},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="handleResult != null and handleResult != ''">#{handleResult},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateAlarmWorkorder" parameterType="AlarmWorkorder">
        update alarm_workorder
        <trim prefix="SET" suffixOverrides=",">
            <if test="workorderNo != null and workorderNo != ''">workorder_no = #{workorderNo},</if>
            <if test="workorderConfigId != null">workorder_config_id = #{workorderConfigId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="assigneeId != null">assignee_id = #{assigneeId},</if>
            <if test="assigneeName != null">assignee_name = #{assigneeName},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where workorder_id = #{workorderId}
    </update>

    <update id="deleteAlarmWorkorderByIds" parameterType="String">
        update alarm_workorder set del_flag = '2' where workorder_id in
        <foreach item="workorderId" collection="array" open="(" separator="," close=")">
            #{workorderId}
        </foreach>
    </update>
</mapper>
